# ==========================================
# ZeroLeak Docker Environment Configuration
# ==========================================
# Copy this file to .env before running docker compose:
#   cp .env.docker.example .env

# --- Database & Cache Credentials ---
MONGO_USERNAME=zeroleak
MONGO_PASSWORD=zeroleak_secret
REDIS_PASSWORD=zeroleak_redis

# --- Backend Application Settings ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# --- Security & Secrets ---
# Generate random 32-byte strings or run: openssl rand -base64 32
ACCESS_TOKEN_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRY=1d
QUESTION_ENCRYPTION_KEY=replace_with_base64_aes_256_key_e_g_openssl_rand_base64_32

# --- AI Integration (Optional) ---
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
DOTENV_CONFIG_QUIET=true

# --- Mock Blockchain Ledger ---
FABRIC_ENABLED=true
FABRIC_CHANNEL_NAME=zeroleak-channel
FABRIC_CHAINCODE_NAME=zeroleak
FABRIC_MSP_ID=Org1MSP